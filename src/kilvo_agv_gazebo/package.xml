<?xml version="1.0"?>
<package format="2">
  <name>kilvo_agv_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo 11 warehouse + differential-drive AGV (Mid360-like LiDAR, camera, IMU, wheel encoders) for testing KILVO on ROS 1 Noetic.</description>
  <maintainer email="dev@example.com">dev</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>livox_ros_driver</depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>velodyne_gazebo_plugins</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>kilvo</exec_depend>
</package>
